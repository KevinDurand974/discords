{
  "name": "discords",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "nub@0.9.2",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.2",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "start": "nub index.ts",
    "test": "nub --cwd packages/db run test",
    "db:generate": "nub --cwd packages/db run db:generate",
    "db:migrate": "nub --cwd packages/db run db:migrate"
  },
  "devDependencies": {
    "@nubjs/types": ">=0.4.13 <=0.9.2",
    "@types/node": "^26",
    "typescript": "^7",
    "varlock": "^1.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
