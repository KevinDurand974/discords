# This env file uses @env-spec - see https://varlock.dev/env-spec
#
# @defaultRequired=infer @defaultSensitive=false
# ----------

# Host database URL; Docker derives a separate URL using the postgres service.
# @tag(api, bot, db) @sensitive @required @type=url
DATABASE_URL=

# @tag(api, docker) @required @type=string
POSTGRES_USER=discords
# @tag(api, docker) @required @type=string
POSTGRES_DB=discords
# @tag(api, docker) @sensitive @required @type=string
POSTGRES_PASSWORD=

# @tag(api, docker) @type=port
PORT=3000
# @tag(api, docker) @optional @type=string
NEWS_CORS_ORIGINS=
# @tag(api, bot, docker) @sensitive @optional @type=string
NEWS_INTERNAL_TOKEN=
# @tag(api, bot, jobs, docker) @sensitive @optional @type=string
JOBS_INTERNAL_TOKEN=
# YouTube Data API key: only the API container receives this value.
# @tag(api, docker) @sensitive @optional @type=string
YOUTUBE_API_KEY=

# @tag(bot) @sensitive @required @type=string
DISCORD_TOKEN=
# @tag(bot) @sensitive @required @type=string
DISCORD_CLIENT_ID=
# @tag(bot) @sensitive @required @type=string
DISCORD_OWNER_CLIENT_ID=
# @tag(bot) @sensitive @optional @type=string
DISCORD_GUILD_ID=

# Host service URLs; Compose overrides these with service DNS names.
# @tag(bot, jobs) @optional @type=url
NEWS_API_URL=http://localhost:3000
# Defaults to NEWS_API_URL when unset.
# @tag(bot, jobs) @optional @type=url
YOUTUBE_API_URL=
# @tag(bot) @optional @type=port
BOT_HEALTH_PORT=3001
# @tag(bot) @optional @type=string
BOT_HEALTH_HOST=127.0.0.1
# @tag(jobs) @optional @type=url
REDIS_URL=redis://127.0.0.1:6379
# @tag(jobs) @optional @type=url
BOT_URL=http://127.0.0.1:3001
# @tag(jobs) @type=port
JOBS_DASHBOARD_PORT=3002
# @tag(jobs) @optional @type=string
JOBS_DASHBOARD_HOST=127.0.0.1
