# Copy this file to .env at the repository root. Never commit actual secrets.
# URL-encode special characters in the DATABASE_URL password.
POSTGRES_USER=discords
POSTGRES_DB=discords
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://discords:replace-with-a-local-password@localhost:5432/discords
PORT=3000
NEWS_CORS_ORIGINS=
NEWS_INTERNAL_TOKEN=
JOBS_INTERNAL_TOKEN=
YOUTUBE_API_KEY=

# Required only for the bot. Choose long random internal tokens above for Docker.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_OWNER_CLIENT_ID=
DISCORD_GUILD_ID=

# Local defaults. Docker overrides service URLs and listen hosts automatically.
NEWS_API_URL=http://localhost:3000
YOUTUBE_API_URL=
BOT_HEALTH_PORT=3001
BOT_HEALTH_HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379
BOT_URL=http://127.0.0.1:3001
JOBS_DASHBOARD_PORT=3002
JOBS_DASHBOARD_HOST=127.0.0.1
