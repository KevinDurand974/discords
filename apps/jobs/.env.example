# Redis must already be running locally.
REDIS_URL=redis://127.0.0.1:6379
NEWS_API_URL=http://127.0.0.1:3000
BOT_URL=http://127.0.0.1:3001
# Use the same long random value in apps/api/.env and apps/bot/.env.
JOBS_INTERNAL_TOKEN=replace-with-a-long-random-secret
JOBS_DASHBOARD_PORT=3002
JOBS_DASHBOARD_HOST=127.0.0.1
