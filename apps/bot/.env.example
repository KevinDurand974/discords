DISCORD_TOKEN=replace-with-your-token
DISCORD_CLIENT_ID=replace-with-your-client-id
DISCORD_OWNER_CLIENT_ID=replace-with-your-owner-id
# Optional: only for guild command deployment.
DISCORD_GUILD_ID=
# For use from the host; use postgres as hostname when running in Compose.
DATABASE_URL=postgresql://discords:replace-with-a-local-password@localhost:5432/discords
NEWS_API_URL=http://localhost:3000
# Optional override; otherwise NEWS_API_URL is used.
YOUTUBE_API_URL=
# Match NEWS_INTERNAL_TOKEN in apps/api/.env for host-side bot runs.
NEWS_INTERNAL_TOKEN=
# Match JOBS_INTERNAL_TOKEN in apps/api/.env and apps/jobs/.env.
JOBS_INTERNAL_TOKEN=
BOT_HEALTH_PORT=3001
BOT_HEALTH_HOST=127.0.0.1
