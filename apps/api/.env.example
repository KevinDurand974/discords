DATABASE_URL=postgresql://discords:replace-with-a-local-password@localhost:5432/discords
POSTGRES_USER=discords
POSTGRES_DB=discords
POSTGRES_PASSWORD=replace-with-a-local-password
PORT=3000
# Exact comma-separated browser origins; leave blank to disable cross-origin access.
NEWS_CORS_ORIGINS=
# Required when enabling the bot Compose profile. Generate a long random secret.
NEWS_INTERNAL_TOKEN=
# Match JOBS_INTERNAL_TOKEN in apps/jobs/.env.
JOBS_INTERNAL_TOKEN=
# Optional, API only. Enable YouTube Data API v3 to resolve @handles.
# Direct UC channel IDs and RSS polling work without this key.
YOUTUBE_API_KEY=
