# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# PostgreSQL connection string for running the API on the host. Docker Compose
# derives its own URL using the postgres service hostname and the values below.
# @sensitive @required @type=url
DATABASE_URL=

# PostgreSQL credentials for the Docker Compose database.
# @required @type=string
POSTGRES_USER=discords
# @required @type=string
POSTGRES_DB=discords
# @sensitive @required @type=string
POSTGRES_PASSWORD=

# HTTP listen port (defaults to 3000).
# @type=port
PORT=3000

# Comma-separated exact browser origins. Empty means no cross-origin browser access.
# @optional @type=string
NEWS_CORS_ORIGINS=

# Shared secret between API and bot for rate-limit isolation (use a random value).
# @sensitive @optional @type=string
NEWS_INTERNAL_TOKEN=

# Shared secret authorizing the local jobs worker to trigger ingestion.
# @sensitive @optional @type=string
JOBS_INTERNAL_TOKEN=

# YouTube Data API v3 key, used only by the API for @handle resolution.
# Direct UC channel IDs and recurring RSS reads do not require a key.
# @sensitive @optional @type=string
YOUTUBE_API_KEY=
